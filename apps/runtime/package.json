{
  "name": "@deliveryos/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "worker": "tsx watch --env-file=../../.env src/worker.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "start:worker": "tsx --env-file=../../.env src/worker.ts",
    "soak:100": "tsx --env-file=../../.env scripts/soak.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@deliveryos/contracts": "workspace:*",
    "@deliveryos/database": "workspace:*",
    "@deliveryos/domain": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "bullmq": "^5.58.5",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
